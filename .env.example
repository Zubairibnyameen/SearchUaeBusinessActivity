# Database
DATABASE_URL="postgresql://user:password@localhost:5432/uae_activity_intelligence"

# ── Supabase (authentication) ────────────────────────────────────────────────
# Only the PUBLIC project values go here. The service-role key is never read
# by this application and must NOT be added to any NEXT_PUBLIC_* variable.
# Project URL — Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Publishable / anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# ── Admin authorization ─────────────────────────────────────────────────────
# Comma-separated allowlist of emails that are promoted to role 'admin' in
# app_users on sign-in. This is the ONLY thing that grants admin access: there
# is no admin password. An empty value means nobody is an allowlisted admin.
# Never place credentials or tokens in this variable.
ADMIN_EMAILS="admin@example.com,owner@example.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
